// Guelph Gym Live Counter - Prisma schema
// Postgres (Neon) via prisma-client-js.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A gym member (student, alumnus, community, etc.).
// cardUid is stored in the same uppercase colon-delimited format emitted by the ESP32.
model Member {
  id                    String       @id @default(cuid())
  cardUid               String       @unique
  firstName             String
  lastName              String
  email                 String?      @unique
  photoUrl              String?
  membershipTier        String
  membershipStart       DateTime     @default(now())
  membershipEnd         DateTime
  isActive              Boolean      @default(true)

  // Authoritative live presence state. A successful approved scan toggles this.
  // Denied/expired/inactive/unknown scans never change these fields.
  isInside              Boolean      @default(false)
  currentVisitStartedAt DateTime?

  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  scanEvents            ScanEvent[]
  gymSessions           GymSession[]

  @@index([cardUid])
  @@index([isActive, membershipEnd])
  @@index([isInside])
}

// Every physical card tap at a gate.
// One tap = one ScanEvent. Success or failure both stored.
enum ScanDirection {
  IN
  OUT
}

enum ScanResult {
  SUCCESS
  DENIED_EXPIRED
  DENIED_UNKNOWN_CARD
  DENIED_INACTIVE
  DENIED_ALREADY_INSIDE
  DENIED_NOT_INSIDE
}

model ScanEvent {
  id         String         @id @default(cuid())
  memberId   String?
  member     Member?        @relation(fields: [memberId], references: [id])
  cardUid    String
  direction  ScanDirection
  result     ScanResult
  gateId     String         @default("gate-1")
  scannedAt  DateTime       @default(now())

  @@index([scannedAt])
  @@index([memberId, scannedAt])
  @@index([cardUid, scannedAt])
}

// A completed visit: entry + exit pair.
// Created on successful scan-out. Used for average-time-in-gym calculation.
model GymSession {
  id              String    @id @default(cuid())
  memberId        String
  member          Member    @relation(fields: [memberId], references: [id])
  enteredAt       DateTime
  exitedAt        DateTime
  durationMinutes Int
  createdAt       DateTime  @default(now())

  @@index([memberId, enteredAt])
  @@index([enteredAt])
}

model Facility {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  maxCapacity  Int
  openTime     String
  closeTime    String
  address      String?
  updatedAt    DateTime @updatedAt
}
